{% comment %} ================================================
  POEDAGAR — VIDEO BANNER (CASI PARALLAX)
  Fondo de video en loop + capa de contenido que
  se desplaza con efecto parallax en el scroll.
  Soporta: video de Shopify, URL externa (mp4),
  o imagen de portada como fallback.
  100% configurable desde Admin → Personalizar.
================================================ {% endcomment %}

{%- assign s = section.settings -%}
{%- assign sid = section.id -%}

<section id="poedagar-vb-{{ sid }}" class="poedagar-vb" aria-label="{{ s.title | escape }}">

  <!-- VIDEO DE FONDO -->
  <div class="poedagar-vb__video-wrap" id="poedagar-vb-bg-{{ sid }}">
    {%- if s.video != blank -%}
      {{- s.video | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          class: 'poedagar-vb__video',
          preload: 'auto',
          image_size: '1400x'
      -}}
    {%- elsif s.video_url != blank -%}
      <video
        class="poedagar-vb__video"
        autoplay="autoplay" loop="loop" muted playsinline preload="auto"
        {%- if s.poster -%} poster="{{ s.poster | image_url: width: 1400 }}" {%- endif -%}
      >
        <source src="{{ s.video_url }}" type="video/mp4">
      </video>
    {%- elsif s.poster -%}
      <img src="{{ s.poster | image_url: width: 1600 }}" width="1600" height="{{ 1600 | divided_by: s.poster.aspect_ratio | round }}" alt="" class="poedagar-vb__video poedagar-vb__video--img" loading="eager">
    {%- endif -%}
  </div>

  <!-- OVERLAY DE COLOR + DEGRADADO -->
  {%- if s.show_overlay -%}
    <div class="poedagar-vb__overlay"
      style="background:{{ s.overlay_color }};opacity:{{ s.overlay_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}
  {%- if s.show_gradient -%}
    <div class="poedagar-vb__gradient"
      style="background:linear-gradient({{ s.gradient_dir }},{{ s.gradient_color }} 0%,rgba(0,0,0,0) 100%);opacity:{{ s.gradient_opacity | divided_by: 100.0 }};"></div>
  {%- endif -%}

  <!-- CONTENIDO — desplazamiento parallax suave -->
  <div class="poedagar-vb__content poedagar-vb__content--{{ s.h_align }}" id="poedagar-vb-content-{{ sid }}">
    <div class="poedagar-vb__inner" style="max-width:{{ s.content_width }}px;">

      {%- if s.eyebrow != blank -%}
        <p class="poedagar-vb__eyebrow" style="color:{{ s.eyebrow_color }};font-size:{{ s.eyebrow_size }}px;font-family:{{ s.text_font }};">{{ s.eyebrow }}</p>
      {%- endif -%}

      {%- if s.title != blank -%}
        <h2 class="poedagar-vb__title" style="color:{{ s.text_color }};font-family:{{ s.title_font }};font-size:clamp(2rem,{{ s.title_size }}vw,{{ s.title_size | times: 14 }}px);line-height:{{ s.title_lh | divided_by: 10.0 }};">{{ s.title }}</h2>
      {%- endif -%}

      {%- if s.subtitle != blank -%}
        <p class="poedagar-vb__sub" style="color:{{ s.sub_color }};font-size:{{ s.sub_size }}px;font-family:{{ s.text_font }};">{{ s.subtitle }}</p>
      {%- endif -%}

      <div class="poedagar-vb__ctas" style="margin-top:{{ s.cta_gap }}px;">
        {%- if s.cta_text != blank and s.cta_link != blank -%}
          <a href="{{ s.cta_link }}" class="poedagar-vb__btn"
            style="background:{{ s.btn_bg }};color:{{ s.btn_color }};border-color:{{ s.btn_bg }};font-size:{{ s.btn_size }}px;padding:{{ s.btn_pv }}px {{ s.btn_ph }}px;border-radius:{{ s.btn_radius }}px;font-family:{{ s.text_font }};">
            {{ s.cta_text }}
          </a>
        {%- endif -%}
        {%- if s.cta2_text != blank and s.cta2_link != blank -%}
          <a href="{{ s.cta2_link }}" class="poedagar-vb__btn poedagar-vb__btn--ghost"
            style="color:{{ s.text_color }};border-color:{{ s.text_color }};font-size:{{ s.btn_size }}px;padding:{{ s.btn_pv }}px {{ s.btn_ph }}px;border-radius:{{ s.btn_radius }}px;font-family:{{ s.text_font }};">
            {{ s.cta2_text }}
          </a>
        {%- endif -%}
      </div>

      <!-- Icono play si tiene link de video externo para abrir modal -->
      {%- if s.play_link != blank -%}
        <a href="{{ s.play_link }}" class="poedagar-vb__play" style="color:{{ s.text_color }};margin-top:{{ s.cta_gap }}px;" target="_blank" rel="noopener" aria-label="Ver video">
          <svg width="{{ s.play_size }}" height="{{ s.play_size }}" viewBox="0 0 60 60" fill="none">
            <circle cx="30" cy="30" r="29" stroke="currentColor" stroke-width="1.5" opacity="0.7"/>
            <polygon points="24,18 24,42 44,30" fill="currentColor"/>
          </svg>
          {%- if s.play_label != blank -%}<span>{{ s.play_label }}</span>{%- endif -%}
        </a>
      {%- endif -%}

    </div>
  </div>

</section>

<style>
#poedagar-vb-{{ sid }} {
  position: relative;
  min-height: {{ s.min_height }}px;
  {%- if s.full_height -%} min-height: {{ s.full_vh }}vh; {%- endif -%}
  overflow: hidden;
  display: flex;
  align-items: {{ s.v_align }};
}

#poedagar-vb-{{ sid }} .poedagar-vb__video-wrap {
  position: absolute;
  inset: {% if s.parallax_intensity > 0 %}-15% 0{% else %}0{% endif %};
  z-index: 0;
  will-change: transform;
}

#poedagar-vb-{{ sid }} .poedagar-vb__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#poedagar-vb-{{ sid }} .poedagar-vb__video--img {
  object-position: {{ s.img_position }};
}

#poedagar-vb-{{ sid }} .poedagar-vb__overlay,
#poedagar-vb-{{ sid }} .poedagar-vb__gradient {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

#poedagar-vb-{{ sid }} .poedagar-vb__content {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: {{ s.pad_v }}px {{ s.pad_h }}px;
  will-change: transform;
  transition: transform 0s linear;
}
#poedagar-vb-{{ sid }} .poedagar-vb__content--left   { text-align: left; }
#poedagar-vb-{{ sid }} .poedagar-vb__content--center { text-align: center; }
#poedagar-vb-{{ sid }} .poedagar-vb__content--right  { text-align: right; }

#poedagar-vb-{{ sid }} .poedagar-vb__inner {
  {% if s.h_align == 'center' %}margin: 0 auto;{% elsif s.h_align == 'right' %}margin-left: auto;{% endif %}
}

#poedagar-vb-{{ sid }} .poedagar-vb__eyebrow {
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 600;
  margin: 0 0 16px;
}
#poedagar-vb-{{ sid }} .poedagar-vb__title {
  font-weight: 700;
  margin: 0 0 20px;
  letter-spacing: -0.01em;
}
#poedagar-vb-{{ sid }} .poedagar-vb__sub {
  line-height: 1.65;
  font-weight: 300;
  max-width: 560px;
  margin: 0 0 8px;
  {% if s.h_align == 'center' %}margin-left:auto;margin-right:auto;{% endif %}
}
#poedagar-vb-{{ sid }} .poedagar-vb__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  {% if s.h_align == 'center' %}justify-content:center;{% elsif s.h_align == 'right' %}justify-content:flex-end;{% endif %}
}
#poedagar-vb-{{ sid }} .poedagar-vb__btn {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border: 1.5px solid;
  transition: opacity 0.3s, transform 0.25s;
}
#poedagar-vb-{{ sid }} .poedagar-vb__btn:hover { opacity: 0.82; transform: translateY(-1px); }
#poedagar-vb-{{ sid }} .poedagar-vb__btn--ghost  { background: transparent !important; }

#poedagar-vb-{{ sid }} .poedagar-vb__play {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  font-family: {{ s.text_font }};
  font-size: {{ s.play_label_size }}px;
  font-weight: 500;
  letter-spacing: 0.08em;
  {% if s.h_align == 'center' %}justify-content:center;{% endif %}
}
#poedagar-vb-{{ sid }} .poedagar-vb__play circle { transition: opacity 0.3s; }
#poedagar-vb-{{ sid }} .poedagar-vb__play:hover circle { opacity: 1; }

@media(max-width:768px){
  #poedagar-vb-{{ sid }} .poedagar-vb__content { text-align: center; }
  #poedagar-vb-{{ sid }} .poedagar-vb__sub,
  #poedagar-vb-{{ sid }} .poedagar-vb__ctas,
  #poedagar-vb-{{ sid }} .poedagar-vb__play { margin-left:auto;margin-right:auto;justify-content:center; }
}
</style>

<script>
(function(){
  var sec  = document.getElementById('poedagar-vb-{{ sid }}');
  var vbg  = document.getElementById('poedagar-vb-bg-{{ sid }}');
  var vcnt = document.getElementById('poedagar-vb-content-{{ sid }}');
  if (!sec) return;

  var bgInt  = {{ s.parallax_intensity   | times: 0.07 }};
  var cntInt = {{ s.content_parallax_int | times: 0.04 }};
  var tick   = false;

  function upd(){
    var r  = sec.getBoundingClientRect();
    var vh = window.innerHeight;
    if (r.bottom < 0 || r.top > vh) return;
    var p = (vh - r.top) / (vh + r.height); /* 0→1 */
    var off = (p - 0.5) * 100;
    if (vbg  && bgInt  > 0) vbg.style.transform  = 'translateY(' + (off * bgInt)  + 'px)';
    if (vcnt && cntInt > 0) vcnt.style.transform  = 'translateY(' + (off * cntInt * -1) + 'px)';
  }

  window.addEventListener('scroll', function(){
    if (!tick){ requestAnimationFrame(function(){ upd(); tick=false; }); tick=true; }
  }, { passive: true });
  upd();
})();
</script>

{% schema %}
{
  "name": "Poedagar — Banner Video",
  "settings": [
    { "type":"header","content":"🎬 Video de fondo" },
    { "type":"video","id":"video","label":"Video (subido a Shopify)","info":"Sube un .mp4 / .webm desde Admin → Archivos." },
    { "type":"text","id":"video_url","label":"URL directa de video (mp4)","info":"Alternativa si no usas el picker de video." },
    { "type":"image_picker","id":"poster","label":"Imagen de portada (fallback/poster)","info":"Se muestra en móvil o mientras carga el video." },
    { "type":"select","id":"img_position","label":"Posición imagen fallback","default":"center center",
      "options":[
        {"value":"center top","label":"Arriba"},
        {"value":"center center","label":"Centro"},
        {"value":"center bottom","label":"Abajo"}
      ]
    },
    { "type":"header","content":"📐 Tamaño" },
    { "type":"checkbox","id":"full_height","label":"Usar altura en vh","default":true },
    { "type":"range","id":"full_vh","label":"Altura (vh)","min":30,"max":100,"step":5,"default":75 },
    { "type":"range","id":"min_height","label":"Altura mínima (px)","min":300,"max":900,"step":50,"default":500 },
    { "type":"header","content":"🌀 Parallax" },
    { "type":"range","id":"parallax_intensity","label":"Parallax video (0=ninguno, 10=máximo)","min":0,"max":10,"step":1,"default":4 },
    { "type":"range","id":"content_parallax_int","label":"Contra-parallax contenido (0=ninguno)","min":0,"max":10,"step":1,"default":3,
      "info":"El texto sube mientras la imagen baja — refuerza el efecto de profundidad." },
    { "type":"header","content":"⬛ Overlay" },
    { "type":"checkbox","id":"show_overlay","label":"Capa de color","default":true },
    { "type":"color","id":"overlay_color","label":"Color overlay","default":"#000000" },
    { "type":"range","id":"overlay_opacity","label":"Opacidad overlay (%)","min":0,"max":90,"step":5,"default":40 },
    { "type":"checkbox","id":"show_gradient","label":"Degradado adicional","default":false },
    { "type":"select","id":"gradient_dir","label":"Dirección degradado","default":"to bottom",
      "options":[
        {"value":"to bottom","label":"De arriba hacia abajo"},
        {"value":"to top","label":"De abajo hacia arriba"},
        {"value":"to right","label":"De izquierda a derecha"},
        {"value":"to left","label":"De derecha a izquierda"}
      ]
    },
    { "type":"color","id":"gradient_color","label":"Color del degradado","default":"#000000" },
    { "type":"range","id":"gradient_opacity","label":"Opacidad degradado (%)","min":0,"max":100,"step":5,"default":70 },
    { "type":"header","content":"✍️ Posición del contenido" },
    { "type":"select","id":"h_align","label":"Alineación horizontal","default":"left",
      "options":[
        {"value":"left","label":"Izquierda"},
        {"value":"center","label":"Centro"},
        {"value":"right","label":"Derecha"}
      ]
    },
    { "type":"select","id":"v_align","label":"Alineación vertical","default":"flex-end",
      "options":[
        {"value":"flex-start","label":"Arriba"},
        {"value":"center","label":"Centro"},
        {"value":"flex-end","label":"Abajo"}
      ]
    },
    { "type":"range","id":"content_width","label":"Ancho máx contenido (px)","min":400,"max":1200,"step":50,"default":700 },
    { "type":"range","id":"pad_v","label":"Padding vertical (px)","min":24,"max":160,"step":8,"default":72 },
    { "type":"range","id":"pad_h","label":"Padding horizontal (px)","min":16,"max":80,"step":8,"default":32 },
    { "type":"header","content":"✍️ Eyebrow" },
    { "type":"text","id":"eyebrow","label":"Eyebrow","default":"Nuevo Lanzamiento" },
    { "type":"color","id":"eyebrow_color","label":"Color eyebrow","default":"#cfa85c" },
    { "type":"range","id":"eyebrow_size","label":"Tamaño eyebrow (px)","min":10,"max":18,"step":1,"default":12 },
    { "type":"header","content":"🔠 Título" },
    { "type":"textarea","id":"title","label":"Título","default":"Siente el movimiento." },
    { "type":"color","id":"text_color","label":"Color texto principal","default":"#ffffff" },
    { "type":"range","id":"title_size","label":"Tamaño título (vw)","min":2,"max":8,"step":1,"default":4 },
    { "type":"range","id":"title_lh","label":"Interlineado título (11=1.1)","min":10,"max":14,"step":1,"default":11 },
    { "type":"text","id":"title_font","label":"Fuente título","default":"'Playfair Display', serif" },
    { "type":"header","content":"💬 Subtítulo" },
    { "type":"textarea","id":"subtitle","label":"Subtítulo" },
    { "type":"color","id":"sub_color","label":"Color subtítulo","default":"#cccccc" },
    { "type":"range","id":"sub_size","label":"Tamaño subtítulo (px)","min":12,"max":22,"step":1,"default":17 },
    { "type":"text","id":"text_font","label":"Fuente texto/botón","default":"'Inter', sans-serif" },
    { "type":"header","content":"🔶 Botón 1" },
    { "type":"text","id":"cta_text","label":"Texto botón 1","default":"Explorar colección" },
    { "type":"url","id":"cta_link","label":"URL botón 1" },
    { "type":"color","id":"btn_bg","label":"Fondo botón 1","default":"#cfa85c" },
    { "type":"color","id":"btn_color","label":"Texto botón 1","default":"#1a1a1a" },
    { "type":"range","id":"btn_size","label":"Fuente botón (px)","min":11,"max":18,"step":1,"default":13 },
    { "type":"range","id":"btn_pv","label":"Padding vertical botón","min":8,"max":28,"step":2,"default":14 },
    { "type":"range","id":"btn_ph","label":"Padding horizontal botón","min":16,"max":60,"step":4,"default":32 },
    { "type":"range","id":"btn_radius","label":"Radio botón (px)","min":0,"max":40,"step":2,"default":2 },
    { "type":"range","id":"cta_gap","label":"Espacio descripción→botones (px)","min":12,"max":60,"step":4,"default":28 },
    { "type":"header","content":"⬜ Botón 2 (ghost)" },
    { "type":"text","id":"cta2_text","label":"Texto botón 2 (vacío=oculta)" },
    { "type":"url","id":"cta2_link","label":"URL botón 2" },
    { "type":"header","content":"▶️ Botón Play (modal externo)" },
    { "type":"url","id":"play_link","label":"URL al video completo (YouTube/Vimeo, vacío=oculta)" },
    { "type":"text","id":"play_label","label":"Texto junto al botón play" },
    { "type":"range","id":"play_size","label":"Tamaño ícono play (px)","min":40,"max":100,"step":5,"default":60 },
    { "type":"range","id":"play_label_size","label":"Tamaño texto play (px)","min":12,"max":18,"step":1,"default":14 }
  ],
  "presets":[
    {
      "name":"Poedagar — Banner Video","category":"Poedagar",
      "settings":{
        "title":"Siente el movimiento.",
        "eyebrow":"Nueva Colección",
        "cta_text":"Explorar ahora"
      }
    }
  ]
}
{% endschema %}
