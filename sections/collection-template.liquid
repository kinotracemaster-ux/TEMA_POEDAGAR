  {%- comment -%}
    SISTEMA DE ORDENAMIENTO COMPLETO PARA VARIANTES.
    - Orden inicial controlado por admin (default_variant_sort)
    - El cliente puede cambiar el orden con el dropdown
    - Incluye shuffle con separación de variantes del mismo producto
  {%- endcomment -%}
  {%- if section.settings.show_variants_as_products -%}
    <script>
      (function() {
        var container = document.getElementById('product-grid-variants');
        if (!container) return;

        var defaultSort = '{{ section.settings.default_variant_sort }}';

        /* ====== FUNCIONES DE ORDENAMIENTO ====== */

        function getItems() {
          return Array.from(container.querySelectorAll('.product-item'));
        }

        function getHandle(el) {
          return el.getAttribute('data-product-handle') || '';
        }

        /* Separar variantes del mismo producto para que no queden juntas */
        function separateVariants(arr) {
          for (var pass = 0; pass < 4; pass++) {
            var swapped = false;
            for (var k = 0; k < arr.length - 1; k++) {
              if (getHandle(arr[k]) === getHandle(arr[k + 1]) && getHandle(arr[k]) !== '') {
                for (var m = k + 2; m < arr.length; m++) {
                  if (getHandle(arr[m]) !== getHandle(arr[k])) {
                    var t = arr[k + 1]; arr[k + 1] = arr[m]; arr[m] = t;
                    swapped = true; break;
                  }
                }
              }
            }
            if (!swapped) break;
          }
          return arr;
        }

        /* Fisher-Yates shuffle */
        function shuffleArray(arr) {
          for (var i = arr.length - 1; i > 0; i--) {
            var j = Math.floor(Math.random() * (i + 1));
            var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
          }
          return arr;
        }

        /* Aplicar un orden al DOM */
        function applyOrder(items) {
          var frag = document.createDocumentFragment();
          for (var i = 0; i < items.length; i++) frag.appendChild(items[i]);
          container.appendChild(frag);
        }

        /* Ordenar según el modo seleccionado */
        function sortVariants(mode) {
          var items = getItems();
          if (items.length < 2) {
            container.style.opacity = '1'; /* reveal aunque solo haya 1 item */
            return;
          }

          switch (mode) {
            case 'random':
              items = separateVariants(shuffleArray(items));
              break;
            case 'price-asc':
              items.sort(function(a, b) {
                return parseInt(a.getAttribute('data-variant-price') || 0) - parseInt(b.getAttribute('data-variant-price') || 0);
              });
              break;
            case 'price-desc':
              items.sort(function(a, b) {
                return parseInt(b.getAttribute('data-variant-price') || 0) - parseInt(a.getAttribute('data-variant-price') || 0);
              });
              break;
            case 'title-asc':
              items.sort(function(a, b) {
                return (a.getAttribute('data-variant-title') || '').localeCompare(b.getAttribute('data-variant-title') || '', 'es');
              });
              break;
            case 'title-desc':
              items.sort(function(a, b) {
                return (b.getAttribute('data-variant-title') || '').localeCompare(a.getAttribute('data-variant-title') || '', 'es');
              });
              break;
            case 'newest':
              items.sort(function(a, b) {
                return parseInt(b.getAttribute('data-created-at') || 0) - parseInt(a.getAttribute('data-created-at') || 0);
              });
              break;
          }

          applyOrder(items);
          container.style.opacity = '1'; /* reveal al terminar el sort */
        }

        /* Mapa de nombres legibles para el label */
        var sortLabels = {
          'random': 'Aleatorio',
          'price-asc': 'Precio: menor a mayor',
          'price-desc': 'Precio: mayor a menor',
          'title-asc': 'Nombre: A–Z',
          'title-desc': 'Nombre: Z–A',
          'newest': 'Más recientes'
        };

        /* Actualizar UI del selector: marcar opción activa + label */
        function updateSortUI(mode) {
          var btns = document.querySelectorAll('[data-variant-sort]');
          for (var b = 0; b < btns.length; b++) {
            btns[b].classList.toggle('is-selected', btns[b].getAttribute('data-variant-sort') === mode);
          }
          var label = document.getElementById('variant-sort-label');
          if (label) label.textContent = 'Ordenar por: ' + (sortLabels[mode] || mode);
        }

        /* ====== ORDEN INICIAL (controlado por Admin) ====== */
        sortVariants(defaultSort); /* reveal incluido dentro de sortVariants */
        updateSortUI(defaultSort);

        /* ====== EVENTOS DEL DROPDOWN (control del cliente) ====== */
        var optionsContainer = document.getElementById('variant-sort-options');
        if (optionsContainer) {
          optionsContainer.addEventListener('click', function(e) {
            var btn = e.target.closest('[data-variant-sort]');
            if (!btn) return;
            var mode = btn.getAttribute('data-variant-sort');

            /* Ocultar grid mientras reordena */
            container.style.opacity = '0';

            setTimeout(function() {
              sortVariants(mode);
              updateSortUI(mode);
              container.style.opacity = '1';

              /* Cerrar el picker */
              var picker = document.getElementById('variant-sort-selector');
              if (picker) picker.setAttribute('aria-hidden', 'true');
            }, 150);
          });
        }
      })();
    </script>
  {%- endif -%}
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function getSectionElement() {
      return document.querySelector('[data-section-type="collection"]');
    }

    function renderFilters(url) {
      window.history.pushState({path: url}, '', url);
      document.dispatchEvent(new CustomEvent('theme:loading:start'));

      const sectionId = getSectionElement().getAttribute('data-section-id');
      const fetchUrl = url + (url.includes('?') ? '&' : '?') + 'section_id=' + sectionId;

      fetch(fetchUrl)
        .then(response => response.text())
        .then(html => {
          const parsedHTML = new DOMParser().parseFromString(html, 'text/html');
          
          const dynamicPart = document.querySelector('.collection__dynamic-part');
          const newDynamicPart = parsedHTML.querySelector('.collection__dynamic-part');
          if (dynamicPart && newDynamicPart) {
            dynamicPart.innerHTML = newDynamicPart.innerHTML;
          }

          const activeFilters = document.querySelector('.collection__active-filters');
          const newActiveFilters = parsedHTML.querySelector('.collection__active-filters');
          if (activeFilters && newActiveFilters) {
            activeFilters.innerHTML = newActiveFilters.innerHTML;
          }
          
          const mobileActiveFilters = document.querySelector('.collection__mobile-active-filters');
          const newMobileActiveFilters = parsedHTML.querySelector('.collection__mobile-active-filters');
          if (mobileActiveFilters && newMobileActiveFilters) {
            mobileActiveFilters.innerHTML = newMobileActiveFilters.innerHTML;
          }

          document.dispatchEvent(new CustomEvent('theme:loading:end'));
        });
    }

    function onFilterChange(event) {
      if (!event.target.closest('#CollectionFiltersForm') && !event.target.closest('#CollectionMobileFiltersForm')) {
        return;
      }
      
      const form = event.target.closest('form');
      const formData = new FormData(form);
      const searchParams = new URLSearchParams(formData);
      
      for (const [key, value] of Array.from(searchParams.entries())) {
        if (!value) {
          searchParams.delete(key);
        }
      }

      const currentUrl = new URL(window.location.href);
      if (currentUrl.searchParams.has('sort_by')) {
        searchParams.set('sort_by', currentUrl.searchParams.get('sort_by'));
      }

      const newUrl = window.location.pathname + '?' + searchParams.toString();
      renderFilters(newUrl);
    }

    document.body.addEventListener('change', onFilterChange);
    
    document.body.addEventListener('click', function(e) {
      const activeCross = e.target.closest('.collection__active-filter-cross') || e.target.closest('.collection__mobile-active-filter-item');
      if (activeCross && activeCross.tagName === 'A') {
        e.preventDefault();
        renderFilters(activeCross.href);
      }
      
      const clearAll = e.target.closest('.collection__clear-filter') || e.target.closest('.collection__mobile-active-clear');
      if (clearAll && clearAll.tagName === 'A') {
        e.preventDefault();
        renderFilters(clearAll.href);
      }

      const clearTagsBtn = e.target.closest('[data-action="clear-tags"]');
      if (clearTagsBtn) {
         e.preventDefault();
         const currentUrl = new URL(window.location.href);
         const sort = currentUrl.searchParams.get('sort_by');
         const newUrl = window.location.pathname + (sort ? '?sort_by=' + sort : '');
         renderFilters(newUrl);
      }
    });
  });
</script>
