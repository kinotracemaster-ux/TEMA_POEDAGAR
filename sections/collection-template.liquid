                              {%- for sub_link in link.links -%}
                                <li>
                                  <a href="{{ sub_link.url }}" class="collection__filter-link link link--primary {% if sub_link.active %}is-active{% endif %}">{{ sub_link.title }} {% if sub_link.type == 'collection_link' and section.settings.quick_links_show_products_count %}({{ sub_link.object.products_count }}){% endif %}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- else -%}
                          <a href="{{ link.url }}" class="collection__filter-link link link--primary {% if link.active or link.child_active %}is-active{% endif %}">{{ link.title }} {% if link.type == 'collection_link' and section.settings.quick_links_show_products_count %}({{ link.object.products_count }}){% endif %}</a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.show_filters -%}
              <form id="CollectionMobileFiltersForm">
                <p class="collection-drawer__section-title">{{ 'collection.filter.all' | t }}</p>

                <div class="collection__filter-group-list">
                  {%- for filter in collection.filters -%}
                    <div class="collection__filter-group">
                      {%- capture link_id -%}mobile-filter-{{ filter.param_name | escape }}{%- endcapture -%}

                      <button type="button" class="collection__filter-group-name link link--secondary text--strong" data-action="toggle-collapsible" aria-controls="{{ link_id }}" data-close-siblings="false" aria-expanded="false">
                        <div>
                          {{- filter.label -}}
                          <span class="collection__filter-item-active" {% if filter.active_values.size == 0 %}style="display: none"{% endif %}>{{ filter.active_values.size }}</span>
                        </div>
                        {%- render 'icon', icon: 'arrow-bottom' -%}
                      </button>

                      <div id="{{ link_id }}" class="collection__filter-collapsible" aria-hidden="true">
                        {%- case filter.type -%}
                          {%- when 'boolean' -%}
                            <ul class="collection__filter-checkbox-list" role="list">
                              <li class="collection__filter-checkbox">
                                <div class="checkbox-wrapper">
                                  <input type="checkbox" class="checkbox" name="{{ filter.param_name }}" value="{{ filter.true_value.value }}" id="Mobile-Filter-{{ filter.param_name }}" {% if filter.true_value.active %}checked{% endif %} {% if filter.true_value.count == 0 and filter.true_value.active == false %}disabled{% endif %}>
                                  {% render 'icon', icon: 'check' %}
                                </div>
                                <label for="Mobile-Filter-{{ filter.param_name }}">{{ filter.true_value.label | escape }} ({{ filter.true_value.count }})</label>
                              </li>
                            </ul>
                          {%- when 'list' -%}
                            <ul class="collection__filter-checkbox-list" role="list">
                              {%- for value in filter.values -%}
                                <li class="collection__filter-checkbox">
                                  <div class="checkbox-wrapper">
                                    <input type="checkbox" class="checkbox" id="Mobile-Filter-{{ filter.param_name }}-{{ forloop.index }}" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked="checked"{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                                    {% render 'icon', icon: 'check' %}
                                  </div>
                                  <label for="Mobile-Filter-{{ filter.param_name }}-{{ forloop.index }}">{{ value.label | escape }} ({{ value.count }})</label>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- when 'price_range' -%}
                            <div class="collection__filter-price-range">
                              <div style="display: flex; gap: 10px; align-items: center;">
                                <div class="price-range__input-group" style="flex:1;">
                                  <input style="width:100%; border:1px solid #ccc; padding:8px;" name="{{ filter.min_value.param_name }}" id="Mobile-Filter-{{ filter.label | escape }}-GTE"
                                    {%- if filter.min_value.value -%}
                                      value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                                    {%- endif -%}
                                    type="number" placeholder="0" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" />
                                </div>
                                <span>-</span>
                                <div class="price-range__input-group" style="flex:1;">
                                  <input style="width:100%; border:1px solid #ccc; padding:8px;" name="{{ filter.max_value.param_name }}" id="Mobile-Filter-{{ filter.label | escape }}-LTE"
                                    {%- if filter.max_value.value -%}
                                      value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                                    {%- endif -%}
                                    type="number" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" />
