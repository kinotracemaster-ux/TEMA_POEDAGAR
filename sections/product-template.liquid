      "default": true
    },
    {
      "type": "html",
      "id": "textomostrarescontolancamento",
      "label": "Texto desconto de lançamento"
    },
    {
      "type": "checkbox",
      "id": "extratexto",
      "label": "Mostrar textos extra",
      "default": true
    },
    {
      "type": "html",
      "id": "icones",
