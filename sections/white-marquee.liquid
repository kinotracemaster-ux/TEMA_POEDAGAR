{%- if section.settings.show_white_marquee -%}
  <div class="white-marquee-section" data-section-id="{{ section.id }}">

    <style>
      #shopify-section-{{ section.id }} {
        background-color: {{ section.settings.bg_color }};
        border-top: {{ section.settings.border_top }}px solid {{ section.settings.border_color }};
        border-bottom: {{ section.settings.border_bottom }}px solid {{ section.settings.border_color }};
        overflow: hidden;
        width: 100%;
        padding: {{ section.settings.padding_v }}px 0;
      }
      #shopify-section-{{ section.id }} .wm-track {
        display: inline-flex;
        white-space: nowrap;
        animation: scroll-wm-{{ section.id }} {{ section.settings.speed }}s linear infinite;
        {%- if section.settings.direction == 'reverse' -%}
          animation-direction: reverse;
        {%- endif -%}
      }
      #shopify-section-{{ section.id }} .wm-item {
        padding: 0 {{ section.settings.item_gap }}px;
        font-size: {{ section.settings.font_size }}px;
        font-weight: {{ section.settings.font_weight }};
        color: {{ section.settings.text_color }};
        text-transform: uppercase;
        letter-spacing: {{ section.settings.letter_spacing }}px;
        font-family: -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
      }
      #shopify-section-{{ section.id }} .wm-separator {
        color: {{ section.settings.separator_color }};
        padding: 0 8px;
      }
      @keyframes scroll-wm-{{ section.id }} {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
    </style>

    {%- assign repeat_count = 10 -%}
    <div class="wm-track">
      {%- for i in (1..repeat_count) -%}
        <span class="wm-item">{{ section.settings.text | escape }}</span>
        {%- if section.settings.show_separator -%}
          <span class="wm-item wm-separator">{{ section.settings.separator }}</span>
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%}Duplicar para loop perfecto{%- endcomment -%}
      {%- for i in (1..repeat_count) -%}
        <span class="wm-item">{{ section.settings.text | escape }}</span>
        {%- if section.settings.show_separator -%}
          <span class="wm-item wm-separator">{{ section.settings.separator }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
{%- endif -%}

{% schema %}
{
  "name": "White Marquee",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_white_marquee",
      "label": "Mostrar marquesina blanca",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "default": "OFERTA ESPECIAL DE LANZAMIENTO - 50 % DE DESCUENTO"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 350,
      "step": 5,
      "unit": "s",
      "label": "Velocidad (seg) — menor = rapido | mayor = casi parada",
      "default": 160
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direccion",
      "options": [
        { "value": "normal",  "label": "Izquierda (normal)" },
        { "value": "reverse", "label": "Derecha (inverso)" }
      ],
      "default": "reverse"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Tamano de texto",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Grosor del texto",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medio" },
        { "value": "700", "label": "Negrita" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Espaciado entre letras",
      "default": 2
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Espacio entre repeticiones",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_v",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Relleno vertical",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Mostrar separador entre textos",
      "default": true
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separador",
      "default": "✦"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Color del separador",
      "default": "#cfa85c"
    },
    {
      "type": "range",
      "id": "border_top",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Borde superior",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_bottom",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Borde inferior",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color del borde",
      "default": "#eaeaea"
    }
  ],
  "presets": [
    {
      "name": "White Marquee"
    }
  ]
}
{% endschema %}
