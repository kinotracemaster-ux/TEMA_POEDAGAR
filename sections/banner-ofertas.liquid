{% comment %} BANNER DE OFERTAS ESPECIALES POEDAGAR {% endcomment %}

<div class="banner-ofertas" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.padding_y }}px 20px; text-align: center;">
  <div class="banner-ofertas__inner" style="max-width: 800px; margin: 0 auto;">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | img_url: '1200x' }}" alt="Ofertas Especiales" style="max-width: 100%; height: auto; border-radius: 8px; margin-bottom: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);">
    {% endif %}
    
    <h2 style="font-family: var(--heading-font-family); margin-bottom: 15px; font-size: {{ section.settings.title_size }}px; font-weight: bold; text-transform: uppercase;">{{ section.settings.title }}</h2>
    <p style="font-size: 16px; margin-bottom: 25px; line-height: 1.5; opacity: 0.9;">{{ section.settings.subtitle }}</p>
    
    {% if section.settings.btn_link != blank and section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link }}" class="button button--primary" style="background-color: var(--gold); color: #111; padding: 15px 35px; border-radius: 4px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; display: inline-block;">
        {{ section.settings.btn_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Banner Ofertas",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de Fondo",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de Texto",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Espaciado Vertical",
      "min": 20,
      "max": 100,
      "step": 5,
      "default": 60
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen Promocional"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título de Oferta",
      "default": "OFERTAS EXCLUSIVAS"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño del Título",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 36
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Aprovecha precios especiales en nuestras líneas seleccionadas. Por tiempo limitado."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Texto del Botón",
      "default": "Ver Ofertas"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Enlace del Botón"
    }
  ],
  "presets": [
    {
      "name": "Banner Ofertas Especiales",
      "category": "Promocional"
    }
  ]
}
{% endschema %}
