{%- comment -%}
  KINO SLIDESHOW — Slider moderno, mobile-first
  Usa scroll-snap nativo + JS ligero para autoplay y navegación
{%- endcomment -%}

<section id="kino-slideshow-{{ section.id }}" class="kino-slideshow" data-section-id="{{ section.id }}" data-section-type="slideshow">

  {%- if section.blocks.size > 0 -%}
    <div class="kino-slideshow__track" id="kino-track-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="kino-slideshow__slide" id="kino-slide-{{ section.id }}-{{ forloop.index0 }}" {{ block.shopify_attributes }}>

          {%- comment -%} IMAGEN DESKTOP {%- endcomment -%}
          {%- if block.settings.image -%}
            <picture>
              {%- if block.settings.mobile_image -%}
                <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 750 }}">
              {%- endif -%}
              <img
                class="kino-slideshow__img"
                src="{{ block.settings.image | image_url: width: 1800 }}"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                {% if forloop.first %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %}
              >
            </picture>
          {%- else -%}
            <div class="kino-slideshow__placeholder">
              {%- capture placeholder -%}{% cycle 'lifestyle-1', 'lifestyle-2' %}{%- endcapture -%}
              {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          {%- comment -%} OVERLAY {%- endcomment -%}
          {%- if block.settings.show_overlay -%}
            {%- assign ov_opacity = block.settings.overlay_opacity | divided_by: 100.0 -%}
            <div class="kino-slideshow__overlay" style="background: linear-gradient(to top, rgba(0,0,0,{{ ov_opacity }}), rgba(0,0,0,{{ ov_opacity | times: 0.3 }}));"></div>
          {%- endif -%}

          {%- comment -%} CONTENIDO {%- endcomment -%}
          {%- capture has_content -%}{{ block.settings.title }}{{ block.settings.content }}{{ block.settings.button_text }}{%- endcapture -%}
          {%- if has_content != blank -%}
            <div class="kino-slideshow__content kino-slideshow__content--{{ block.settings.content_position }}" style="color: {{ block.settings.text_color }};">
              <div class="kino-slideshow__content-inner">
                {%- if block.settings.title != blank -%}
                  <h2 class="kino-slideshow__title">{{ block.settings.title | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.content != blank -%}
                  <p class="kino-slideshow__text">{{ block.settings.content | escape }}</p>
                {%- endif -%}
                {%- if block.settings.button_text != blank and block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="kino-slideshow__btn" style="background: {{ block.settings.button_background }}; color: {{ block.settings.button_text_color }};">
                    {{ block.settings.button_text | escape }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- elsif block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="kino-slideshow__full-link" aria-label="{{ block.settings.title | default: 'Ver más' | escape }}"></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      {%- comment -%} DOTS {%- endcomment -%}
      <div class="kino-slideshow__dots" id="kino-dots-{{ section.id }}">
        {%- for block in section.blocks -%}
          <button class="kino-slideshow__dot {% if forloop.first %}is-active{% endif %}" data-slide="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>

      {%- comment -%} FLECHAS {%- endcomment -%}
      <button class="kino-slideshow__arrow kino-slideshow__arrow--prev" id="kino-prev-{{ section.id }}" aria-label="Anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="kino-slideshow__arrow kino-slideshow__arrow--next" id="kino-next-{{ section.id }}" aria-label="Siguiente">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    {%- endif -%}
  {%- endif -%}
</section>

<style>
  .kino-slideshow {
    position: relative;
    width: 100%;
    overflow: hidden;
    {% unless section.settings.edge_to_edge %}max-width: 1400px; margin: 0 auto;{% endunless %}
    {% if section.settings.redondo %}border-radius: 12px;{% endif %}
  }

  .kino-slideshow__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .kino-slideshow__track::-webkit-scrollbar { display: none; }

  .kino-slideshow__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    scroll-snap-align: start;
    overflow: hidden;
    {% case section.settings.section_size %}
      {% when 'small' %}aspect-ratio: 3 / 1;
      {% when 'medium' %}aspect-ratio: 2.2 / 1;
      {% when 'large' %}aspect-ratio: 16 / 9;
      {% else %}/* preserve_ratio — sin aspect ratio fijo */
    {% endcase %}
  }

  .kino-slideshow__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    {% unless section.settings.section_size == 'preserve_ratio' %}position: absolute; top: 0; left: 0;{% endunless %}
  }

  .kino-slideshow__placeholder {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kino-slideshow__placeholder .placeholder-svg { max-width: 50%; opacity: .35; }

  /* OVERLAY */
  .kino-slideshow__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* FULL-LINK (cuando no hay botón) */
  .kino-slideshow__full-link {
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  /* CONTENIDO */
  .kino-slideshow__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    padding: 28px 24px;
    pointer-events: none;
  }
  .kino-slideshow__content-inner { pointer-events: auto; max-width: 550px; }

  /* Posiciones */
  .kino-slideshow__content--top_left       { align-items: flex-start; justify-content: flex-start; }
  .kino-slideshow__content--top_center     { align-items: flex-start; justify-content: center; text-align: center; }
  .kino-slideshow__content--top_right      { align-items: flex-start; justify-content: flex-end; text-align: right; }
  .kino-slideshow__content--middle_left    { align-items: center; justify-content: flex-start; }
  .kino-slideshow__content--middle_center  { align-items: center; justify-content: center; text-align: center; }
  .kino-slideshow__content--middle_right   { align-items: center; justify-content: flex-end; text-align: right; }
  .kino-slideshow__content--bottom_left    { align-items: flex-end; justify-content: flex-start; }
  .kino-slideshow__content--bottom_center  { align-items: flex-end; justify-content: center; text-align: center; }
  .kino-slideshow__content--bottom_right   { align-items: flex-end; justify-content: flex-end; text-align: right; }

  .kino-slideshow__title {
    font-family: var(--heading-font-family, 'Playfair Display', serif);
    font-size: clamp(22px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 12px;
    text-shadow: 0 2px 12px rgba(0,0,0,.35);
  }
  .kino-slideshow__text {
    font-size: clamp(13px, 1.6vw, 17px);
    line-height: 1.5;
    margin: 0 0 20px;
    opacity: .92;
    text-shadow: 0 1px 6px rgba(0,0,0,.3);
  }
  .kino-slideshow__btn {
    display: inline-block;
    padding: 13px 32px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .5px;
    text-transform: uppercase;
    border-radius: 3px;
    transition: transform .25s, box-shadow .25s;
    text-decoration: none;
  }
  .kino-slideshow__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,.25);
  }

  /* DOTS */
  .kino-slideshow__dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    gap: 10px;
  }
  .kino-slideshow__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,.45);
    border: 2px solid rgba(255,255,255,.7);
    cursor: pointer;
    transition: all .3s;
    padding: 0;
  }
  .kino-slideshow__dot.is-active {
    background: #fff;
    transform: scale(1.25);
    box-shadow: 0 0 8px rgba(255,255,255,.5);
  }

  /* FLECHAS — solo desktop */
  .kino-slideshow__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: background .25s, transform .25s;
    padding: 0;
  }
  .kino-slideshow__arrow:hover {
    background: rgba(255,255,255,.45);
    transform: translateY(-50%) scale(1.08);
  }
  .kino-slideshow__arrow--prev { left: 14px; }
  .kino-slideshow__arrow--next { right: 14px; }

  /* ──── MOBILE ──── */
  @media (max-width: 749px) {
    .kino-slideshow__slide {
      {% case section.settings.section_size %}
        {% when 'small' %}aspect-ratio: 4 / 3;
        {% when 'medium' %}aspect-ratio: 3 / 4;
        {% when 'large' %}aspect-ratio: 9 / 16;
        {% else %}/* preserve_ratio */
      {% endcase %}
    }
    .kino-slideshow__content { padding: 20px 18px; }
    .kino-slideshow__content-inner { max-width: 100%; }
    /* Centrar contenido en móvil siempre */
    .kino-slideshow__content { align-items: flex-end !important; justify-content: center !important; text-align: center !important; }
    .kino-slideshow__arrow { display: none; }
    .kino-slideshow__dots { bottom: 12px; gap: 8px; }
    .kino-slideshow__dot { width: 8px; height: 8px; }
    .kino-slideshow__btn { padding: 12px 26px; font-size: 12px; }
  }
</style>

{%- if section.blocks.size > 1 -%}
<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var track = document.getElementById('kino-track-' + sectionId);
    var dots  = document.querySelectorAll('#kino-dots-' + sectionId + ' .kino-slideshow__dot');
    var prev  = document.getElementById('kino-prev-' + sectionId);
    var next  = document.getElementById('kino-next-' + sectionId);
    var total = {{ section.blocks.size }};
    var current = 0;
    var autoplay = {{ section.settings.autoplay | json }};
    var speed = {{ section.settings.cycle_speed | times: 1000 }};
    var timer;

    function goTo(idx) {
      current = ((idx % total) + total) % total;
      var slide = document.getElementById('kino-slide-' + sectionId + '-' + current);
      if (slide) track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
      for (var i = 0; i < dots.length; i++) {
        dots[i].classList.toggle('is-active', i === current);
      }
    }

    function startAuto() {
      if (!autoplay) return;
      stopAuto();
      timer = setInterval(function() { goTo(current + 1); }, speed);
    }
    function stopAuto() { clearInterval(timer); }

    if (prev) prev.addEventListener('click', function() { stopAuto(); goTo(current - 1); startAuto(); });
    if (next) next.addEventListener('click', function() { stopAuto(); goTo(current + 1); startAuto(); });

    for (var d = 0; d < dots.length; d++) {
      (function(i) {
        dots[i].addEventListener('click', function() { stopAuto(); goTo(i); startAuto(); });
      })(d);
    }

    /* Detectar slide activo por scroll (swipe en móvil) */
    var scrollTimeout;
    track.addEventListener('scroll', function() {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function() {
        var slideW = track.offsetWidth;
        var newIdx = Math.round(track.scrollLeft / slideW);
        if (newIdx !== current) {
          current = newIdx;
          for (var i = 0; i < dots.length; i++) {
            dots[i].classList.toggle('is-active', i === current);
          }
        }
      }, 80);
    });

    /* Pausar al pasar mouse */
    track.addEventListener('mouseenter', stopAuto);
    track.addEventListener('mouseleave', startAuto);

    startAuto();
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Slideshow",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "edge_to_edge",
      "label": "Ancho completo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "redondo",
      "label": "Bordes redondeados",
      "default": false
    },
    {
      "type": "select",
      "id": "section_size",
      "label": "Tamaño de imagen",
      "options": [
        {
          "value": "preserve_ratio",
          "label": "Ratio original"
        },
        {
          "value": "small",
          "label": "Pequeño"
        },
        {
          "value": "medium",
          "label": "Mediano"
        },
        {
          "value": "large",
          "label": "Grande"
        }
      ],
      "default": "preserve_ratio"
    },
    {
      "type": "select",
      "id": "carousel_effect",
      "label": "Efecto de transición",
      "options": [
        {
          "value": "fade",
          "label": "Fade"
        },
        {
          "value": "slide",
          "label": "Slide"
        }
      ],
      "default": "slide"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotación automática",
      "default": true
    },
    {
      "type": "range",
      "id": "cycle_speed",
      "min": 3,
      "max": 8,
      "step": 1,
      "unit": "seg",
      "label": "Cambiar slides cada",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen",
          "info": "1800 x 600px .jpg recomendado"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Imagen móvil",
          "info": "750 x 1100px .jpg recomendado. Si no se agrega, se usará la de escritorio."
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Mostrar overlay",
          "info": "Mejora la legibilidad del texto.",
          "default": true
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Opacidad del overlay",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 35
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Color de texto",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título del Slide"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Descripción"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Posición del contenido",
          "info": "En móvil siempre se centra en la parte inferior.",
          "options": [
            { "value": "top_left", "label": "Arriba izquierda" },
            { "value": "top_center", "label": "Arriba centro" },
            { "value": "top_right", "label": "Arriba derecha" },
            { "value": "middle_left", "label": "Centro izquierda" },
            { "value": "middle_center", "label": "Centro" },
            { "value": "middle_right", "label": "Centro derecha" },
            { "value": "bottom_left", "label": "Abajo izquierda" },
            { "value": "bottom_center", "label": "Abajo centro" },
            { "value": "bottom_right", "label": "Abajo derecha" }
          ],
          "default": "middle_center"
        },
        {
          "type": "header",
          "content": "Botón"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Fondo del botón",
          "default": "#cfa85c"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Texto del botón",
          "default": "#1a1a1a"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Texto",
          "default": "Ver más"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace",
          "info": "Si no hay texto de botón, toda la imagen será clickeable."
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Imagen",
      "name": "Slideshow",
      "blocks": [
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}