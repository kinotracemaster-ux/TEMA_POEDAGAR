<div data-section-id="{{ section.id }}" data-section-type="popups">
  <script>
  document.addEventListener('DOMContentLoaded', () => {

    /* ─── APERTURA AUTOMÁTICA DE POPUPS PROMO ─────────────────── */
    document.querySelectorAll('.modal--promo[data-promo="true"]').forEach(modal => {
      const settings = JSON.parse(modal.dataset.popupSettings || '{}');
      const delay    = (parseInt(settings.apparitionDelay) || 0) * 1000;
      const once     = settings.showOnlyOnce === true;
      const storageKey = 'kino_promo_seen_' + modal.id;

      // Si showOnlyOnce está activo y el usuario ya vio el popup, no mostrar
      if (once && localStorage.getItem(storageKey)) return;

      // Abrir el popup después del delay configurado
      setTimeout(() => {
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('modal-open');
      }, delay);

      // Manejar el cierre (botón close) 
      modal.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-action="close-popup"]');
        if (btn) {
          modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('modal-open');
          if (once) localStorage.setItem(storageKey, '1');
        }

        // Cerrar también al hacer clic en el overlay (fuera del dialog)
        if (e.target === modal) {
          modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('modal-open');
          if (once) localStorage.setItem(storageKey, '1');
        }
      });
    });

    /* ─── COUNTDOWN / AUTO-CLOSE ──────────────────────────────── */
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'aria-hidden') {
          const target = mutation.target;
          if (target.dataset.promo === 'true' && target.getAttribute('aria-hidden') === 'false') {
            startPromoTimer(target);
          }
        }
      });
    });

    document.querySelectorAll('.modal--promo').forEach(modal => {
      observer.observe(modal, { attributes: true });
    });

    function startPromoTimer(modal) {
      const settings = JSON.parse(modal.dataset.popupSettings || '{}');
      if (!settings.autoClose) return;

      const once       = settings.showOnlyOnce === true;
      const storageKey = 'kino_promo_seen_' + modal.id;
      const countdownEl = modal.querySelector('.promo-popup__countdown');
      let timeLeft = parseInt(settings.autoCloseDelay) || 5;

      if (countdownEl) countdownEl.textContent = timeLeft;

      const interval = setInterval(() => {
        timeLeft--;
        if (countdownEl) countdownEl.textContent = timeLeft;

        if (timeLeft <= 0) {
          clearInterval(interval);
          modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('modal-open');
          if (once) localStorage.setItem(storageKey, '1');
        }
      }, 1000);

      // Cancelar countdown si el usuario interactúa
      modal.addEventListener('click', () => clearInterval(interval), { once: true });
    }
  });
</script>

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'newsletter' -%}
        {%- unless block.settings.show_only_on_index and template != 'index' -%}
          {%- unless block.settings.show_only_for_visitors and customer -%}
            {% capture popup_settings %}
              {
                "apparitionDelay": {{ block.settings.apparition_delay | json }},
                "showOnlyOnce": {{ block.settings.show_only_once | json }}
              }
            {% endcapture %}

            <aside class="modal modal--newsletter" data-popup-type="newsletter" data-popup-settings='{{ popup_settings }}' aria-hidden="true" {{ block.shopify_attributes }}>
              <div class="modal__dialog" role="dialog">
                <div class="popup-newsletter">
                  {%- if block.settings.title != blank -%}
                    <h3 class="popup-newsletter__title heading">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}

                  <button class="popup-newsletter__close link" data-action="close-popup" aria-label="{{ 'general.accessibility.close' | t }}">
                    {%- render 'icon', icon: 'close' -%}
                  </button>

                  {%- if block.settings.content != blank -%}
                    <div class="popup-newsletter__content rte">
                      {{ block.settings.content }}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.show_newsletter -%}
                    {%- form 'customer', id: 'newsletter-popup', class: 'form popup-newsletter__form' -%}
                      {%- if form.posted_successfully? -%}
                        <p class="alert alert--success alert--center">{{ 'general.popup.success' | t }}</p>
                      {%- else -%}
                        <input type="hidden" name="contact[tags]" value="newsletter">

                        <div class="form__input-wrapper form__input-wrapper--labelled">
                          <input id="newsletter-popup[email]" type="text" class="form__field form__field--text" name="contact[email]" autofocus>
                          <label for="newsletter-popup[email]" class="form__floating-label">{{ 'general.popup.email_placeholder' | t }}</label>
                        </div>

                        <button class="button button--primary button--full" type="submit">{{ 'general.popup.subscribe' | t }}</button>
                      {%- endif -%}
                    {%- endform -%}
                  {%- endif -%}
                </div>
              </div>
            </aside>
          {%- endunless -%}
        {%- endunless -%}

      {%- when 'exit' -%}
        {%- unless block.settings.show_only_for_visitors and customer -%}
          {% capture popup_settings %}
            {
              "showOnlyOnce": {{ block.settings.show_only_once | json }}
            }
          {% endcapture %}

          <aside class="modal modal--exit-popup" data-popup-type="exit" data-popup-settings='{{ popup_settings }}' aria-hidden="true" {{ block.shopify_attributes }}>
            <div class="modal__dialog" role="dialog">
              <div class="exit-popup">
                {%- if block.settings.title != blank -%}
                  <h3 class="exit-popup__title heading">{{ block.settings.title | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.subheading != blank -%}
                  <p class="exit-popup__subheading heading">{{ block.settings.subheading | escape }}</p>
                {%- endif -%}

                <button class="exit-popup__close link" data-action="close-popup" aria-label="{{ 'general.accessibility.close' | t }}">
                  {%- render 'icon', icon: 'close' -%}
                </button>

                {%- assign is_form_valid = false -%}

                {%- if block.settings.show_newsletter -%}
                  {%- form 'customer', id: 'exit-popup', class: 'form exit-popup__form' -%}
                    {%- if form.posted_successfully? -%}
                      {%- assign is_form_valid = true -%}
                      <p class="alert alert--success alert--center">{{ block.settings.success_message }}</p>
                    {%- else -%}
                      <input type="hidden" name="contact[tags]" value="newsletter">

                      <div class="form__input-wrapper form__input-wrapper--labelled">
                        <input id="exit-popup[email]" type="text" class="form__field form__field--large form__field--text" name="contact[email]" autofocus>
                        <label for="exit-popup[email]" class="form__floating-label">{{ 'general.popup.email_placeholder' | t }}</label>
                      </div>

                      <button class="button button--primary button--extra-large button--full" type="submit">{{ block.settings.button_text | escape }}</button>
                    {%- endif -%}
                  {%- endform -%}
                {%- endif -%}

                {%- if block.settings.close_message != blank and is_form_valid == false -%}
                  <button class="exit-popup__pay-more link link--accented" data-action="close-popup">{{ block.settings.close_message }}</button>
                {%- endif -%}
              </div>
            </div>
          </aside>
        {%- endunless -%}

      {%- when 'promo' -%}
        {%- unless block.settings.show_only_on_index and template != 'index' -%}
          {%- unless block.settings.show_only_for_visitors and customer -%}
            {% capture popup_settings %}
              {
                "apparitionDelay": {{ block.settings.apparition_delay | json }},
                "showOnlyOnce": {{ block.settings.show_only_once | json }},
                "autoClose": {{ block.settings.auto_close | json }},
                "autoCloseDelay": {{ block.settings.auto_close_delay | json }}
              }
            {% endcapture %}

            <aside id="modal-promo-{{ block.id }}" class="modal modal--promo" data-popup-type="newsletter" data-promo="true" data-popup-settings='{{ popup_settings }}' aria-hidden="true" {{ block.shopify_attributes }}>
              <div class="modal__dialog" role="dialog">
                <div class="promo-popup" style="{% if block.settings.image %}background-image: url({{ block.settings.image | img_url: '800x' }});{% endif %}">
                  <div class="promo-popup__overlay" style="background-color: {{ block.settings.overlay_color }}; opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
                  
                  <div class="promo-popup__content">
                    <button class="promo-popup__close link" data-action="close-popup" aria-label="{{ 'general.accessibility.close' | t }}">
                      {%- render 'icon', icon: 'close' -%}
                    </button>

                    {%- if block.settings.title != blank -%}
                      <h3 class="promo-popup__title heading">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}

                    {%- if block.settings.subheading != blank -%}
                      <div class="promo-popup__subheading">
                        {{ block.settings.subheading }}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.button_text != blank -%}
                      <div class="promo-popup__actions">
                        <a href="{{ block.settings.button_link }}" class="button button--primary promo-popup__button">{{ block.settings.button_text | escape }}</a>
                      </div>
                    {%- endif -%}

                    {%- if block.settings.auto_close -%}
                      <div class="promo-popup__footer">
                        <div class="promo-popup__timer">
                          <span class="promo-popup__timer-text">Oferta expira en <span class="promo-popup__countdown">{{ block.settings.auto_close_delay }}</span>s</span>
                          <div class="promo-popup__timer-bar">
                            <div class="promo-popup__timer-progress" style="animation-duration: {{ block.settings.auto_close_delay }}s"></div>
                          </div>
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </aside>
          {%- endunless -%}
        {%- endunless -%}
    {%- endcase -%}
  {%- endfor -%}
</div>

