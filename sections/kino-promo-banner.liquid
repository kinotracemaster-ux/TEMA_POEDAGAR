<section class="kino-promo-banner section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="kino-promo-banner">
  {%- style -%}
    .section-{{ section.id }} {
      --banner-height-desktop: {{ section.settings.height_desktop }}px;
      --banner-height-mobile: {{ section.settings.height_mobile }}px;
      --overlay-color: {{ section.settings.overlay_color | color_modify: 'alpha', 0.5 }};
      --text-color: {{ section.settings.text_color }};
      --content-bg: {{ section.settings.content_bg_color | color_modify: 'alpha', 0.1 }};
    }

    .kino-promo-banner {
      position: relative;
      width: 100%;
      height: var(--banner-height-mobile);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #f4f4f4;
    }

    @media screen and (min-width: 769px) {
      .kino-promo-banner {
        height: var(--banner-height-desktop);
      }
    }

    .kino-promo-banner__image-wrapper {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .kino-promo-banner__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .kino-promo-banner__overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: {{ section.settings.overlay_gradient | default: 'rgba(0,0,0,0.3)' }};
      z-index: 2;
    }

    .kino-promo-banner__container {
      position: relative;
      z-index: 3;
      width: 100%;
      max-width: var(--container-max-width);
      padding: 0 20px;
      display: flex;
      flex-direction: column;
      align-items: {{ section.settings.content_alignment }};
      text-align: {{ section.settings.content_alignment }};
    }

    .kino-promo-banner__content-box {
      max-width: 600px;
      padding: 40px;
      border-radius: 12px;
      color: var(--text-color);
      {% if section.settings.enable_glassmorphism %}
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.2);
      {% endif %}
    }

    .kino-promo-banner__badge {
      display: inline-block;
      padding: 5px 12px;
      background: {{ section.settings.badge_bg_color }};
      color: {{ section.settings.badge_text_color }};
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      border-radius: 4px;
      margin-bottom: 20px;
    }

    .kino-promo-banner__title {
      font-family: var(--heading-font-family);
      font-weight: var(--heading-font-weight);
      font-size: clamp(32px, 5vw, 56px);
      line-height: 1.1;
      margin-bottom: 15px;
      color: inherit;
    }

    .kino-promo-banner__text {
      font-size: 18px;
      line-height: 1.6;
      margin-bottom: 30px;
      opacity: 0.95;
    }

    .kino-promo-banner__buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      justify-content: {{ section.settings.content_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' }};
    }

    /* Sincronización con el sistema de botones de la tienda */
    .kino-promo-banner .button {
       min-height: 52px !important;
       padding: 0 30px !important;
       border-radius: 6px !important;
       display: inline-flex;
       align-items: center;
       justify-content: center;
       text-transform: uppercase;
       font-weight: bold;
       font-size: 15px;
       letter-spacing: 1px;
       transition: all 0.3s ease;
       text-decoration: none;
    }

    .kino-promo-banner .button--primary {
       background: {{ section.settings.btn_primary_bg }};
       color: {{ section.settings.btn_primary_text }};
    }

    .kino-promo-banner .button--secondary {
       background: transparent;
       border: 2px solid var(--text-color);
       color: var(--text-color);
    }
    
    .kino-promo-banner .button:hover {
       transform: translateY(-2px);
       box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    @media screen and (max-width: 768px) {
      .kino-promo-banner__content-box {
        padding: 30px 20px;
        width: 100%;
        background: none;
        backdrop-filter: none;
        border: none;
        box-shadow: none;
      }
      .kino-promo-banner__title {
        font-size: 32px;
      }
      .kino-promo-banner__buttons {
        flex-direction: column;
      }
      .kino-promo-banner .button {
        width: 100%;
      }
    }
  {%- endstyle -%}

  <div class="kino-promo-banner__image-wrapper">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | img_url: '800x' }}">
        {%- endif -%}
        <img class="kino-promo-banner__image" 
             src="{{ section.settings.image | img_url: '1600x' }}" 
             alt="{{ section.settings.title | escape }}"
             loading="lazy">
      </picture>
    {%- endif -%}
    <div class="kino-promo-banner__overlay"></div>
  </div>

  <div class="kino-promo-banner__container">
    <div class="kino-promo-banner__content-box">
      {%- if section.settings.badge_text != blank -%}
        <span class="kino-promo-banner__badge">{{ section.settings.badge_text | escape }}</span>
      {%- endif -%}
      
      {%- if section.settings.title != blank -%}
        <h2 class="kino-promo-banner__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <div class="kino-promo-banner__text">
          {{ section.settings.subtitle | newline_to_br }}
        </div>
      {%- endif -%}

      <div class="kino-promo-banner__buttons">
        {%- if section.settings.button_1_text != blank -%}
          <a href="{{ section.settings.button_1_link }}" class="button button--primary">{{ section.settings.button_1_text | escape }}</a>
        {%- endif -%}

        {%- if section.settings.button_2_text != blank -%}
          <a href="{{ section.settings.button_2_link }}" class="button button--secondary">{{ section.settings.button_2_text | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kino Promo Banner",
  "settings": [
    {
      "type": "header",
      "content": "Imágenes"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen de fondo (Móvil)"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 400,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Altura Desktop",
      "default": 600
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 300,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Altura Móvil",
      "default": 500
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Etiqueta (Opcional)",
      "default": "OFERTA EXCLUSIVA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "Colección Premium"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo o Descripción",
      "default": "Descubre la elegancia y precisión en cada detalle de nuestras nuevas piezas exclusivas."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Alineación del contenido",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Estilos y Colores"
    },
    {
      "type": "checkbox",
      "id": "enable_glassmorphism",
      "label": "Activar efecto Cristal (Glassmorphism)",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del Texto",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "overlay_gradient",
      "label": "Gradiente de Superposición",
      "default": "linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.6) 100%)"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Fondo de la Etiqueta",
      "default": "#cfa85c"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Texto de la Etiqueta",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Botones"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Texto Botón 1",
      "default": "Ver Colección"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link Botón 1"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Fondo Botón 1",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_primary_text",
      "label": "Texto Botón 1",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Texto Botón 2",
      "default": "Hablar por WhatsApp"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link Botón 2"
    }
  ],
  "presets": [
    {
      "name": "Kino Promo Banner",
      "category": "Image"
    }
  ]
}
{% endschema %}
