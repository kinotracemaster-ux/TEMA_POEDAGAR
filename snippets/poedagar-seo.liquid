{%- comment -%}
  SEO metadata for the main layout. Use verified Shopify data only.
  Titles, canonical URLs and social cards are owned by the layout.
  Do not force indexing or publish commercial policies in hidden markup.
{%- endcomment -%}
{%- liquid
  assign seo_store_url = shop.url
  assign seo_store_id = seo_store_url | append: '/#organization'
  assign seo_website_id = seo_store_url | append: '/#website'
  assign seo_description = shop.description | strip_html | strip
  assign seo_public_page = false
  case request.page_type
    when 'index', 'product', 'collection', 'page', 'blog', 'article'
      assign seo_public_page = true
  endcase
-%}
{%- if seo_public_page -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ seo_store_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ seo_store_url | json }}
      {%- if seo_description != blank -%},
      "description": {{ seo_description | json }}
      {%- endif %}
    },
    {
      "@type": "WebSite",
      "@id": {{ seo_website_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ seo_store_url | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "publisher": { "@id": {{ seo_store_id | json }} }
    },
    {
      "@type": {% if request.page_type == 'collection' %}"CollectionPage"{% else %}"WebPage"{% endif %},
      "@id": {{ canonical_url | append: '#webpage' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ page_title | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      "isPartOf": { "@id": {{ seo_website_id | json }} }
      {%- if page_description != blank -%},
      "description": {{ page_description | strip_html | json }}
      {%- endif %}
    }
  ]
}
</script>
{%- if request.page_type == 'product' and product != blank -%}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>
{%- elsif request.page_type == 'article' and article != blank -%}
<script type="application/ld+json">
  {{ article | structured_data }}
</script>
{%- endif -%}
{%- comment -%}Fallback only: the layout owns the configured description.{%- endcomment -%}
{%- if page_description == blank -%}
  {%- liquid
    assign seo_fallback_description = seo_description
    case request.page_type
      when 'product'
        assign seo_fallback_description = product.description | strip_html | strip | default: seo_description
      when 'collection'
        assign seo_fallback_description = collection.description | strip_html | strip | default: seo_description
      when 'page'
        assign seo_fallback_description = page.content | strip_html | strip | default: seo_description
      when 'article'
        assign seo_fallback_description = article.excerpt_or_content | strip_html | strip | default: seo_description
    endcase
  -%}
  {%- if seo_fallback_description != blank -%}
<meta name="description" content="{{ seo_fallback_description | truncate: 160 | escape }}">
  {%- endif -%}
{%- endif -%}
{%- endif -%}
