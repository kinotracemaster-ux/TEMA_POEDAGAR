{%- assign social_media_count = 0 -%}

{%- capture social_media -%}
  {%- if settings.social_facebook != blank -%}
    <li class="social-media__item social-media__item--facebook">
      <a href="{{ settings.social_facebook | replace_first: 'https://', '' | replace_first: 'http://', '' | prepend: 'https://' }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_label' | t: social_media: 'Facebook' }}">
        {%- render 'icon', icon: 'facebook' -%} {%- if show_social_media_name -%}Facebook{%- endif -%}
      </a>
    </li>
    {% assign social_media_count = social_media_count | plus: 1 %}
  {%- endif -%}

  {%- if settings.social_instagram != blank -%}
    <li class="social-media__item social-media__item--instagram">
      <a href="{{ settings.social_instagram | replace_first: 'https://', '' | replace_first: 'http://', '' | prepend: 'https://' }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_label' | t: social_media: 'Instagram' }}">
        {%- render 'icon', icon: 'instagram' -%} {%- if show_social_media_name -%}Instagram{%- endif -%}
      </a>
    </li>
    {% assign social_media_count = social_media_count | plus: 1 %}
  {%- endif -%}

  {%- if settings.social_tiktok != blank -%}
    <li class="social-media__item social-media__item--tiktok">
      <a href="{{ settings.social_tiktok | replace_first: 'https://', '' | replace_first: 'http://', '' | prepend: 'https://' }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_label' | t: social_media: 'TikTok' }}">
        {%- render 'icon', icon: 'tiktok' -%} {%- if show_social_media_name -%}TikTok{%- endif -%}
      </a>
    </li>
    {% assign social_media_count = social_media_count | plus: 1 %}
  {%- endif -%}

  {%- if settings.whatsapp_number != blank -%}
    <li class="social-media__item social-media__item--whatsapp">
      <a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        {%- render 'icon', icon: 'whatsapp' -%} {%- if show_social_media_name -%}WhatsApp{%- endif -%}
      </a>
    </li>
    {% assign social_media_count = social_media_count | plus: 1 %}
  {%- endif -%}
{%- endcapture -%}

{%- if social_media_count > 0 -%}
  <ul class="social-media__item-list {% if show_social_media_name %}social-media__item-list--stack{% endif %} list--unstyled" role="list">
    {{ social_media }}
  </ul>
{%- endif -%}